# Example environment file for --mint-urns (NRS / urn-minter credentials).
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; never commit real credentials.

# Apigee proxy URL for the target environment:
#   dev  : https://dev.apis.huit.harvard.edu/lts-nrs-admin-api
#   qa   : https://stage.apis.huit.harvard.edu/lts-nrs-admin-api
#   prod : https://apis.huit.harvard.edu/lts-nrs-admin-api
NRS_ENDPOINT=https://stage.apis.huit.harvard.edu/lts-nrs-admin-api

# Request agent name (must have permission for the authority path in NRS).
NRS_AGENT=aviary-minting

# Apigee-issued API key for the SAME environment as NRS_ENDPOINT.
NRS_APIGEE_API_KEY=your_apigee_api_key_here

# Optional: HTTP timeout in seconds (default 30).
# NRS_TIMEOUT=30

# Optional: default NRS authority path for --urn-authority (default HUL.TEST).
# DEFAULT_AUTHORITY_PATH=HUL.TEST
